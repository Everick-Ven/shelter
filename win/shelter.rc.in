#include <windows.h>

// Иконка с наименьшим ID идёт первой — это иконка приложения.
IDI_SHELTER ICON "@SHELTER_ICON_RESOURCE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SHELTER_FILE_VERSION_RC@
 PRODUCTVERSION @SHELTER_FILE_VERSION_RC@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Golubev & Kulkov"
            VALUE "FileDescription", "SHELTER - Private Browser"
            VALUE "FileVersion", "@SHELTER_VERSION@"
            VALUE "InternalName", "Shelter"
            VALUE "OriginalFilename", "Shelter.exe"
            VALUE "ProductName", "SHELTER"
            VALUE "ProductVersion", "@SHELTER_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
